{
  "name": "@myrddraall/heroes-replay-stats-common",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Common: the app's general UI pieces (the theme's styles, the side panel, sprites, masks, empty states) and, until the replays domain takes them, the stat tables",
  "types": "./index.ts",
  "sideEffects": false,
  "scripts": {
    "check.contrast": "node design-system/build/contrast.ts",
    "format": "prettier --write \"**/*.ts\"",
    "generate.design-system": "node design-system/build/generate.ts",
    "generate.design-system-previews": "node design-system/build/previews.ts",
    "generate.theme": "node tools/generate-theme.ts",
    "github.actions.test": "pnpm test",
    "lint": "eslint .",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tools && tsc --noEmit -p design-system/build"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cdk": "^22.1.0",
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./ui": "./ui/index.ts",
    "./model": "./model/index.ts"
  },
  "type": "module"
}
