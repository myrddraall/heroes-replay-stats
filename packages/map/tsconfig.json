{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    // The root's `paths` are for Sheriff; this package resolves the others through their workspace
    // links, so `rootDir` keeps it to its own sources.
    "paths": {},
    "noEmit": true,
    // Angular components and directives drawn in the browser; the tests run the plain
    // functions in Node.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  // Restated on purpose: the root config's `exclude` lists `packages`, which would
  // exclude this whole project if inherited.
  "exclude": ["node_modules"]
}
