{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "projects": {
    "aether": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "prefix": "aether",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.json",
            "buildTarget": "aether:build"
          }
        }
      }
    }
  }
}
