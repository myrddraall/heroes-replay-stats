{
  "name": "heroes-replay-stats-workspace",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Heroes of the Storm replay statistics — an Angular app for the browser and the desktop (Electron)",
  "scripts": {
    "build": "devutil run build",
    "check": "wireit",
    "check.contrast": "pnpm --filter @myrddraall/heroes-replay-stats-common check.contrast",
    "check.boundaries": "sheriff verify web,replay-worker,desktop-main,desktop-preload",
    "clean": "wireit",
    "fix": "wireit",
    "format": "wireit",
    "gitflow": "gitflow",
    "lint": "devutil run lint",
    "postinstall": "devutil dev-link auto",
    "prepare": "husky || true",
    "reset": "wireit",
    "test": "devutil run test",
    "typecheck": "devutil run typecheck",
    "start": "pnpm --filter @myrddraall/heroes-replay-stats start",
    "stop": "node tools/stop-servers.ts",
    "desktop": "pnpm --filter @myrddraall/heroes-replay-stats-desktop dev",
    "generate.analysis-goldens": "pnpm --filter @myrddraall/heroes-replay-stats-analysers goldens:generate",
    "generate.design-system": "pnpm --filter @myrddraall/heroes-replay-stats-common generate.design-system",
    "generate.design-system-previews": "pnpm --filter @myrddraall/heroes-replay-stats-common generate.design-system-previews",
    "generate.theme": "pnpm --filter @myrddraall/heroes-replay-stats-common generate.theme",
    "generate.play-background": "heroes-capture ui background -o apps/web/public/backgrounds/play",
    "serve.maps": "node tools/serve-maps.ts",
    "serve.reports": "node tools/serve-reports.ts",
    "serve.sheets": "node tools/serve-sheets.ts",
    "generate.domain": "ng generate domain",
    "generate.library": "ng generate library",
    "generate.layer": "ng generate layer",
    "generate.testing": "ng generate testing",
    "generate.featureset": "ng generate featureset",
    "generate.feature-component": "ng generate feature-component",
    "generate.ui-component": "ng generate ui-component",
    "generate.store": "ng generate store",
    "generate.store-feature": "ng generate store-feature",
    "generate.slot": "ng generate slot",
    "generate.worker": "ng generate worker",
    "generate.uses": "ng generate uses",
    "generate.move": "ng generate move",
    "generate.extract-domain": "ng generate extract-domain",
    "generate.publishable": "ng generate publishable"
  },
  "devDependencies": {
    "@angular/cli": "^22.2.5",
    "@cpdevtools/git-flow": "^1.1.1",
    "@cpdevtools/git-flow-cli": "^1.1.1",
    "@cpdevtools/schematics": "^0.1.0",
    "@cpdevtools/ts-dev-utilities-cli": "^1.1.6",
    "@softarc/eslint-plugin-sheriff": "^0.20.0",
    "@softarc/sheriff-core": "^0.20.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "syncpack": "^13.0.0",
    "typescript": "~6.0.2",
    "wireit": "^0.14.13"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "wireit": {
    "fix": {
      "dependencies": [
        "fix.syncpack",
        "fix.git-remove-tags",
        "format"
      ]
    },
    "fix.deps": {
      "command": "devutil dep-versions fix .publish/deps.yml"
    },
    "fix.git-remove-tags": {
      "command": "git tag | xargs -r git tag -d"
    },
    "fix.syncpack": {
      "command": "syncpack fix-mismatches",
      "dependencies": [
        "fix.deps"
      ]
    },
    "format": {
      "dependencies": [
        "format.prettier",
        "format.projects"
      ]
    },
    "format.syncpack": {
      "command": "syncpack format"
    },
    "format.prettier": {
      "command": "prettier --write \"**/*.{ts,js,json,md,yml}\" --ignore-path .gitignore",
      "dependencies": [
        "format.syncpack"
      ]
    },
    "format.projects": {
      "command": "devutil run format"
    },
    "check": {
      "dependencies": [
        "check.deps",
        "check.syncpack"
      ]
    },
    "check.deps": {
      "command": "devutil dep-versions check .publish/deps.yml"
    },
    "check.syncpack": {
      "command": "syncpack list-mismatches"
    },
    "clean": {
      "dependencies": [
        "clean.install"
      ]
    },
    "clean.git": {
      "command": "git clean -dfX",
      "cache": false
    },
    "clean.install": {
      "command": "pnpm install",
      "dependencies": [
        "clean.git"
      ],
      "cache": false
    },
    "reset": {
      "dependencies": [
        "reset.git",
        "pnpm.install"
      ]
    },
    "reset.git": {
      "command": "git reset --hard",
      "cache": false
    },
    "pnpm.install": {
      "command": "pnpm install",
      "cache": false
    }
  },
  "license": "MIT",
  "type": "module",
  "domainPackages": {
    "scope": "@myrddraall/heroes-replay-stats-",
    "prefix": "hrs",
    "apps": "apps",
    "packages": "packages",
    "libs": "libs",
    "sheriffConfig": "sheriff.config.ts"
  }
}
